<IfModule mod_rewrite.c>
    RewriteEngine On

    # Paksa akses browser melalui HTTPS; endpoint ACME tetap tersedia via HTTP.
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteCond %{SERVER_PORT} ^80$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Hentikan pemrosesan ulang setelah internal rewrite ke direktori public.
    RewriteRule ^public(?:/|$) - [L]

    # Layani file dan direktori publik (misalnya build Vite) dari public/.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Semua route aplikasi lainnya ditangani oleh front controller Laravel.
    RewriteRule ^ public/index.php [L]
</IfModule>
